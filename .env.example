# Copy to .env and fill in only the providers you actually use.
# dotenv is loaded automatically by solarphunk.config.

# --- Model selection ---------------------------------------------------------
# Primary model, as "<provider>:<model>". Examples:
#   anthropic:claude-sonnet-5
#   anthropic:claude-opus-4-8
#   openai:gpt-5.5
#   google_genai:gemini-2.5-pro
AGENT_MODEL=anthropic:claude-sonnet-5

# Optional comma-separated fallback chain, tried in order if the primary errors.
# Leave blank to disable fallbacks.
AGENT_FALLBACK_MODELS=

# Optional cheaper model for delegated sub-agent work. Falls back to AGENT_MODEL.
AGENT_SUBAGENT_MODEL=anthropic:claude-haiku-4-5

# Sampling temperature for all models.
AGENT_TEMPERATURE=0

# --- Provider API keys (set the ones matching your models) ------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Persistence -----------------------------------------------------------
# If set, conversation state is checkpointed to this SQLite file so runs with
# the same --thread id resume. Leave blank for in-memory only.
AGENT_CHECKPOINT_DB=.agent_state.sqlite
